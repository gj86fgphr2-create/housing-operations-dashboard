[Unit]
Description=Collect WTYZ meter exceptions and synchronize the Yuxiaor dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/wtyz-meter-collector
EnvironmentFile=/home/ubuntu/wtyz-meter-collector/config/wtyz.env
ExecStart=/usr/bin/python3 /home/ubuntu/wtyz-meter-collector/collect_meter_management.py --output-dir /home/ubuntu/wtyz-meter-collector/data
ExecStopPost=/home/ubuntu/wtyz-meter-collector/sync-meter-management.sh
TimeoutStartSec=10min
Nice=12
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/wtyz-meter-collector/data
StandardOutput=append:/home/ubuntu/wtyz-meter-collector/logs/collector.log
StandardError=append:/home/ubuntu/wtyz-meter-collector/logs/collector.log

[Install]
WantedBy=multi-user.target
